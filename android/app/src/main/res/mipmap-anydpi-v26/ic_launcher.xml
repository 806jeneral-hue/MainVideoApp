<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon (Android 8+).

    The launcher masks the foreground to whatever shape the device uses, so the
    ribbon is kept well inside the safe zone and the ivory is a full-bleed
    background layer rather than part of the artwork.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
