<?xml version="1.0" encoding="utf-8"?>
<!-- The collapsed notification card: the same row as the mini player inside
     the app, with a rounded cover, the title, and three round buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <ImageView
        android:id="@+id/cover"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="centerCrop"
        android:src="@drawable/notif_cover_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@android:style/TextAppearance.Material.Notification.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true" />

        <TextView
            android:id="@+id/subtitle"
            style="@android:style/TextAppearance.Material.Notification.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/previous"
        android:layout_width="38dp"
        android:layout_height="38dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/notif_circle_glass" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="9dp"
            android:src="@drawable/ic_notif_previous" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/toggle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp">

        <ImageView
            android:id="@+id/toggle_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/notif_circle_fill" />

        <ImageView
            android:id="@+id/toggle_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:src="@drawable/ic_notif_pause" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/next"
        android:layout_width="38dp"
        android:layout_height="38dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/notif_circle_glass" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="9dp"
            android:src="@drawable/ic_notif_next" />
    </FrameLayout>
</LinearLayout>
